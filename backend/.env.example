# Lynsea backend environment — copy to backend/.env and fill in.
# NEVER commit the real .env (it is gitignored).

# Claude API key. ALL model calls go through app/llm.py, which reads this.
CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default model tier (high-frequency state/scoring -> Haiku).
# Tier map in config.py: opus -> claude-opus-4-8, sonnet -> claude-sonnet-4-6,
# haiku -> this value.
DEFAULT_MODEL=claude-haiku-4-5

# Optional explicit per-tier overrides (defaults shown).
# OPUS_MODEL=claude-opus-4-8
# SONNET_MODEL=claude-sonnet-4-6

# CORS origin for the Next.js frontend dev server.
FRONTEND_ORIGIN=http://localhost:3000
